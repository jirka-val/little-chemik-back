# Copy to .env and fill in. .env is git-ignored - never commit real values.
# Every key is optional; the defaults are in app/core/config.py.

# Shared admin password for /api/incidents (error reports) and force-field
# reclassification. Empty = admin endpoints are locked.
ADMIN_TOKEN=

# Extra browser origins allowed to call the API cross-origin. Not needed when
# the frontend is served from the same address (production nginx, Vite proxy).
# BACKEND_CORS_ORIGINS=https://example.org,https://other.example.org

# Error reporting (user-consented incident reports).
# INCIDENT_REPORTS_ENABLED=true
# INCIDENTS_MAX_TOTAL_MB=5000
# INCIDENT_MAX_MB=300

# How often the force-field catalog is refreshed from IDA (seconds).
# FF_CATALOG_REFRESH_INTERVAL_SECONDS=86400

# Storage locations (defaults are inside the backend directory).
# WORKSPACE_DIR=/app/temp_workspaces
# INCIDENTS_DIR=/app/data/incidents

# Only read by scripts/incidents.py (ignored by the backend): address of the
# server whose error reports you want to list/download.
# FORGE_URL=https://forge.example.org
